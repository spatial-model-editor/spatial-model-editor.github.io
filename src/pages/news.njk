{% extends "layouts/base.njk" %}
{% from "macros/news_card.njk" import news_card %}

{% block content %}
<section class="pb-2 pb-lg-4">
  <div class="container px-lg-3">
    {% for release in releases %}
      {{ news_card("Version " + release.version + " released", release.date, release.url, release.notes) }}
    {% endfor %}
  </div>
</section>
{% endblock %}
