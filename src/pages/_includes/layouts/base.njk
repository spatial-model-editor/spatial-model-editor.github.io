<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Spatial Model Editor is a user friendly GUI editor to create and edit spatial SBML models of bio-chemical reactions and simulate them using the dune-copasi solver for reaction-diffusion systems.">
  <meta name="author" content="Liam Keegan">
  <meta name="google-site-verification" content="j9-pKiY0YNWFAS0d9qsHQr8aFUtvYHVxAYrZenKMcmI">
  <title>{% if page.filePathStem != "/index" %}Spatial Model Editor - {% endif %}{{ page_title }}</title>
  <link rel="icon" type="image/svg+xml" href="assets/sme.svg">
  <link href="css/bootstrap.min.css" rel="stylesheet">
  <link href="css/styles.css" rel="stylesheet">
  <script src="js/bootstrap.bundle.min.js" defer></script>
  <script src="js/modal_on_pageload.js" defer></script>
  {% block scripts %}{% endblock %}
</head>
<body>
  {% include "navbar.njk" %}
  {% block header %}
  <div class="p-2 p-lg-4 text-center">
    <h1 class="display-5 fw-bold">{{ page_title }}</h1>
  </div>
  {% endblock %}
  {% block content %}{% endblock %}
  {% block modals %}{% endblock %}
</body>
</html>
