{% macro video_card(title, description, video_file, url_code, url_colab, id) %}
<div class="row align-items-center row-cols-1">
  <div class="col-lg-12 col-xxl-12 mb-5">
    <div class="card border-1 shadow-lg" id="{{ id }}">
      <div class="card-body text-center p-4 p-lg-2 pt-2 pt-lg-2">
        <div class="row justify-content-center p-2">
          <div class="col text-start">
            <a class="btn btn-outline-primary" href="{{ url_code }}">
              <i class="bi bi-file-earmark-code" aria-hidden="true"></i> Source Code
            </a>
          </div>
          <div class="col">
            <h2 class="fs-4 fw-bold">{{ title }}</h2>
          </div>
          <div class="col text-end">
            <a class="btn btn-outline-primary" href="{{ url_colab }}">
              <i class="bi bi-journal-code" aria-hidden="true"></i> Interactive Notebook
            </a>
          </div>
        </div>
        <div class="row">
          <p>{{ description | safe }}</p>
        </div>
        <div class="row">
          <video class="w-100" controls autoplay loop muted playsinline>
            <source src="assets/{{ video_file }}" type="video/mp4">
          </video>
        </div>
      </div>
    </div>
  </div>
</div>
{% endmacro %}
