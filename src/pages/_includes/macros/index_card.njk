{% macro index_card(card) %}
<div class="col-lg-6 col-xxl-4 mb-5">
  <div class="card border-1 h-100 shadow-lg">
    <div class="card-body text-center p-4 p-lg-5 pt-0 pt-lg-0">
      <div class="feature bg-primary bg-gradient text-white rounded-3 mb-4 mt-n4">
        {% if card.url %}
        <a href="{{ card.url }}" aria-label="{{ card.title }}">{% icon card.icon %}</a>
        {% else %}
        {% icon card.icon %}
        {% endif %}
      </div>
      <h2 class="fs-4 fw-bold simplelink">
        {% if card.url %}<a href="{{ card.url }}">{{ card.title }}</a>{% else %}{{ card.title }}{% endif %}
      </h2>
      {% if card.links %}
      <div class="list-group list-group-flush">
        {% for name, link in card.links %}
        <a class="list-group-item list-group-item-action" href="{{ link }}">{{ name }}</a>
        {% endfor %}
      </div>
      {% endif %}
      {% if card.downloads %}
      <div class="row align-items-center row-cols-2 pt-3 simplelink">
        {% for download in card.downloads %}
        <div class="col p-0">
          <a href="{{ download.url }}">
            <div class="card border-1 bg-light text-nowrap p-2 m-1 align-items-center">
              <div class="fs-1 lh-1">{% icon download.icon %}</div>
              <p class="mt-0 mb-0">{{ download.name }}</p>
            </div>
          </a>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% endmacro %}
